rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidAdminRole(role) {
      return role in [
        'Super Administrator',
        'Electoral Commissioner',
        'SRC Election Administrator',
        'Hall Election Administrator',
        'GRASAG Election Administrator',
        'Local NUGS Election Administrator',
        'Departmental Election Administrator',
        'Faculty/School Election Administrator',
        'Returning Officer',
        'Results Auditor'
      ];
    }

    function hasTrustedAdminClaim() {
      return request.auth.token.get('admin', false) == true;
    }

    // Require an explicit, active /admins/{uid} record with a recognized non-student
    // administrator role. Missing /admins/{uid} documents, omitted isActive fields,
    // deactivated records, and stale custom claims without an active profile are denied.
    function isAdminRecordActive() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('isActive', false) == true
        && ('role' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
        && isValidAdminRole(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role);
    }

    function isAdmin() {
      return isSignedIn()
        && hasTrustedAdminClaim()
        && isAdminRecordActive();
    }

    function isGlobalGovernanceAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in [
          'Super Administrator',
          'Electoral Commissioner'
        ]
        && (
          !('managedDomainIds' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds == null
          || (
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds is list
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds.size() == 0
          )
        )
        && (
          !('managedHalls' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedHalls == null
          || (
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedHalls is list
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedHalls.size() == 0
          )
        );
    }

    function isUnscopedElectionGovernanceAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in [
        'Super Administrator',
        'Electoral Commissioner',
        'Returning Officer'
      ]
      && (
        !('managedDomainIds' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds == null
        || (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds is list
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds.size() == 0
        )
      );
    }

    function canAdminManageElectionDomain(electionData) {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role != 'Results Auditor'
        && (
          isUnscopedElectionGovernanceAdmin()
          || (
            ('managedDomainIds' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds is list
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds.size() > 0
            && ('domainId' in electionData)
            && electionData.domainId is string
            && electionData.domainId in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.managedDomainIds
          )
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Null-safe zero check: treats missing, null, or numeric 0 as zero, while rejecting > 0 or non-numeric tampering.
    function hasZeroCount(data, field) {
      return !(field in data)
        || data[field] == null
        || ((data[field] is int || data[field] is float) && data[field] == 0);
    }

    function isFlagTrue(data, field) {
      return (field in data) && data[field] == true;
    }

    function hasProtectedElectionResults(electionId) {
      return isValidId(electionId)
        && exists(/databases/$(database)/documents/election_results/$(electionId))
        && (
          isFlagTrue(get(/databases/$(database)/documents/election_results/$(electionId)).data, 'isPublished')
          || isFlagTrue(get(/databases/$(database)/documents/election_results/$(electionId)).data, 'resultsCertified')
        );
    }

    function electionAllowsDeletion(electionId, electionData) {
      return isValidId(electionId)
        && canAdminManageElectionDomain(electionData)
        && ('status' in electionData)
        && electionData.status is string
        && electionData.status in [
          'draft',
          'pending_approval',
          'scheduled',
          'upcoming',
          'suspended',
          'closed',
          'cancelled',
          'archived'
        ]
        && !isFlagTrue(electionData, 'isHistorical')
        && hasZeroCount(electionData, 'totalVotesCast')
        && !isFlagTrue(electionData, 'resultsCertified')
        && !hasProtectedElectionResults(electionId);
    }

    function electionAllowsChildDeletion(electionId) {
      return isValidId(electionId)
        && exists(/databases/$(database)/documents/elections/$(electionId))
        && electionAllowsDeletion(
          electionId,
          get(/databases/$(database)/documents/elections/$(electionId)).data
        );
    }

    function isValidContestantData(data) {
      return data.keys().hasAll(['fullName', 'department', 'faculty', 'level', 'hall', 'updatedAt'])
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150
        && data.department is string && data.department.size() <= 150
        && data.faculty is string && data.faculty.size() <= 150
        && data.level is string && data.level.size() <= 64
        && data.hall is string && data.hall.size() <= 120
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 64))
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('programme' in data) || (data.programme is string && data.programme.size() <= 160))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (!('photoStoragePath' in data) || (data.photoStoragePath is string && data.photoStoragePath.size() <= 512))
        && (!('biography' in data) || (data.biography is string && data.biography.size() <= 10000))
        && (!('leadershipExperience' in data) || data.leadershipExperience is list)
        && data.updatedAt is timestamp;
    }

    function positionBelongsToElection(positionId, electionId) {
      return isValidId(positionId)
        && isValidId(electionId)
        && existsAfter(/databases/$(database)/documents/positions/$(positionId))
        && getAfter(/databases/$(database)/documents/positions/$(positionId)).data.electionId == electionId;
    }

    // Student profiles: users can read/create own pending profile and update non-privileged fields.
    // Eligibility, account status, and role fields cannot be set or modified by ordinary users.
    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isEligible == false
        && request.resource.data.eligibilityStatus == 'pending_verification'
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'admin', 'permissions']);
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isEligible',
          'eligibilityStatus',
          'eligibilityNotes',
          'status',
          'role',
          'isAdmin',
          'admin',
          'permissions',
          'uid'
        ])
      );
      allow delete: if resource != null && isAdmin();
    }

    // Authoritative UCC voter eligibility records (Admin-managed only)
    match /voter_eligibility/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    // Duplicate-vote lock collection: written exclusively by Cloud Functions Admin SDK
    match /voter_authorisations/{authDocId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Anonymous ballots: never readable or writable directly from client SDKs
    match /ballots/{ballotId} {
      allow read, write: if false;
    }

    // Vote receipts (no candidate selections stored): written exclusively by Cloud Functions Admin SDK
    match /vote_confirmations/{receiptId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Elections and Contested Positions
    match /elections/{electionId} {
      allow read: if true;
      allow create: if isValidId(electionId)
        && isAdmin()
        && canAdminManageElectionDomain(request.resource.data);
      allow update: if isValidId(electionId)
        && isAdmin()
        && canAdminManageElectionDomain(resource.data)
        && canAdminManageElectionDomain(request.resource.data)
        // Prevent mutating historical status off or decrementing recorded votes to bypass delete guards
        && (!isFlagTrue(resource.data, 'isHistorical') || isFlagTrue(request.resource.data, 'isHistorical'))
        && (
          hasZeroCount(resource.data, 'totalVotesCast')
          || (
            ('totalVotesCast' in request.resource.data)
            && (request.resource.data.totalVotesCast is int || request.resource.data.totalVotesCast is float)
            && request.resource.data.totalVotesCast >= resource.data.totalVotesCast
          )
        );
      allow delete: if isValidId(electionId)
        && isAdmin()
        && resource != null
        && electionAllowsDeletion(electionId, resource.data);
    }

    match /positions/{positionId} {
      allow read: if true;
      allow create: if isValidId(positionId)
        && isAdmin()
        && ('electionId' in request.resource.data)
        && isValidId(request.resource.data.electionId)
        && existsAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId))
        && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data);
      allow update: if isValidId(positionId)
        && isAdmin()
        && ('electionId' in resource.data)
        && isValidId(resource.data.electionId)
        && exists(/databases/$(database)/documents/elections/$(resource.data.electionId))
        && canAdminManageElectionDomain(get(/databases/$(database)/documents/elections/$(resource.data.electionId)).data)
        && ('electionId' in request.resource.data)
        && isValidId(request.resource.data.electionId)
        && existsAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId))
        && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data);
      allow delete: if isValidId(positionId)
        && isAdmin()
        && resource != null
        && ('electionId' in resource.data)
        && isValidId(resource.data.electionId)
        && electionAllowsChildDeletion(resource.data.electionId);
    }

    // Permanent reusable contestant profiles (contains contact PII -> strictly admin-only)
    match /contestants/{contestantId} {
      allow get: if isValidId(contestantId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(contestantId) && isAdmin()
        && isValidContestantData(request.resource.data)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);
      allow update: if isValidId(contestantId) && isAdmin()
        && isValidContestantData(request.resource.data)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isValidId(contestantId) && resource != null && isAdmin();
    }

    // Assignment uniqueness index preventing duplicate (electionId, positionId, contestant) entries
    match /candidate_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(assignmentId)
        && isAdmin()
        && request.resource.data.candidateId is string
        && positionBelongsToElection(request.resource.data.positionId, request.resource.data.electionId)
        && existsAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId))
        && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data);
      allow update: if isValidId(assignmentId)
        && isAdmin()
        && ('electionId' in resource.data)
        && isValidId(resource.data.electionId)
        && exists(/databases/$(database)/documents/elections/$(resource.data.electionId))
        && canAdminManageElectionDomain(get(/databases/$(database)/documents/elections/$(resource.data.electionId)).data)
        && request.resource.data.candidateId is string
        && positionBelongsToElection(request.resource.data.positionId, request.resource.data.electionId)
        && existsAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId))
        && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data);
      allow delete: if isValidId(assignmentId)
        && isAdmin()
        && resource != null
        && ('electionId' in resource.data)
        && isValidId(resource.data.electionId)
        && electionAllowsChildDeletion(resource.data.electionId);
    }

    // Candidate Nominations & Election-Specific Participation Records
    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if isValidId(candidateId) && (
        (
          isAdmin()
          && ('electionId' in request.resource.data)
          && isValidId(request.resource.data.electionId)
          && existsAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId))
          && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data)
          && (!('positionId' in request.resource.data) || request.resource.data.positionId == '' || positionBelongsToElection(request.resource.data.positionId, request.resource.data.electionId))
        )
        ||
        (
          isSignedIn()
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.applicationStatus in ['Draft', 'Submitted']
          && !('votesReceived' in request.resource.data)
          && !('reviewedBy' in request.resource.data)
          && !('reviewedAt' in request.resource.data)
          && !('contestantId' in request.resource.data)
          && (!('eligibilityVerified' in request.resource.data) || request.resource.data.eligibilityVerified == false)
          && ('electionId' in request.resource.data)
          && isValidId(request.resource.data.electionId)
        )
      );
      allow update: if isValidId(candidateId) && (
        (
          isAdmin()
          && ('electionId' in resource.data)
          && isValidId(resource.data.electionId)
          && exists(/databases/$(database)/documents/elections/$(resource.data.electionId))
          && canAdminManageElectionDomain(get(/databases/$(database)/documents/elections/$(resource.data.electionId)).data)
          && ('electionId' in request.resource.data)
          && isValidId(request.resource.data.electionId)
          && existsAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId))
          && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data)
          && (!('positionId' in request.resource.data) || request.resource.data.positionId == '' || positionBelongsToElection(request.resource.data.positionId, request.resource.data.electionId))
        )
        ||
        (
          isSignedIn()
          && resource != null
          && resource.data.submittedByUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'eligibilityVerified',
            'reviewedBy',
            'reviewedAt',
            'votesReceived',
            'rejectionReason',
            'contestantId',
            'submittedByUid'
          ])
          && (
            request.resource.data.applicationStatus == resource.data.applicationStatus
            || (
              resource.data.applicationStatus in ['Draft', 'Rejected']
              && request.resource.data.applicationStatus == 'Submitted'
            )
          )
          && (
            resource.data.applicationStatus == 'Draft'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'electionId',
              'positionId'
            ])
          )
        )
      );
      allow delete: if isValidId(candidateId)
        && isAdmin()
        && resource != null
        && hasZeroCount(resource.data, 'votesReceived')
        && ('electionId' in resource.data)
        && isValidId(resource.data.electionId)
        && electionAllowsChildDeletion(resource.data.electionId);
    }

    // Certified / Published Election Results
    match /election_results/{electionId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow create, update: if isValidId(electionId)
        && isAdmin()
        && existsAfter(/databases/$(database)/documents/elections/$(electionId))
        && canAdminManageElectionDomain(getAfter(/databases/$(database)/documents/elections/$(electionId)).data);
      allow delete: if isValidId(electionId)
        && isAdmin()
        && resource != null
        && !isFlagTrue(resource.data, 'isPublished')
        && !isFlagTrue(resource.data, 'resultsCertified')
        && electionAllowsChildDeletion(electionId);
    }

    // Structural UCC Governance Registry (plus __directory_config controlled strictly by Global Governance Admins)
    match /domains/{domainId} {
      allow read: if true;
      allow create, update: if domainId == '__directory_config'
        ? isGlobalGovernanceAdmin()
        : isAdmin();
      allow delete: if resource != null && (
        domainId == '__directory_config'
          ? isGlobalGovernanceAdmin()
          : isAdmin()
      );
    }

    match /halls/{hallId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    match /faculties/{facultyId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    // Public Announcements & Election Calendar
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    match /calendar_events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    // Notifications (global targetUid == null or user-targeted) & per-user read tracking
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.targetUid == null ||
        resource.data.targetUid == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    match /notification_reads/{readId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.uid == request.auth.uid) ||
        readId.matches('^' + request.auth.uid + '_.*')
      );
      allow write: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        readId.matches('^' + request.auth.uid + '_.*');
    }

    // Student Complaints / Petitions
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if resource != null && isAdmin();
    }

    // Administrator accounts: readable only by owner or verified admins;
    // writable ONLY by trusted Firebase Admin SDK / Cloud Functions (never via client SDKs).
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Immutable Audit Logs
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
